{
  "name": "joyvet-sales",
  "productName": "JoyvetSales",
  "version": "1.4.0",
  "description": "Joyvet Sales Desktop Application",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "package": "npm run build && electron-builder build --publish never",
    "package-all": "npm run build && electron-builder build -mwl",
    "package-mac": "npm run build && electron-builder build --mac --x64",
    "package-linux": "npm run build && electron-builder build --linux",
    "package-win": "npm run build && electron-builder build --win --x64",
    "lint": "biome check .",
    "format": "biome format .",
    "start": "cross-env NODE_ENV=production electron ./out/main/index.js",
    "postinstall": "electron-builder install-app-deps",
    "test": "vitest run",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "build": {
    "productName": "JoyvetSales",
    "appId": "org.develar.JoyvetSales",
    "files": [
      "out/",
      "app/package.json"
    ],
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage"
      ],
      "category": "Development"
    },
    "directories": {
      "buildResources": "resources",
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "owner": "wemmyo",
      "repo": "joyvet-desktop",
      "private": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wemmyo/joyvet-desktop.git"
  },
  "author": {
    "name": "David Oyedeji",
    "email": "wemmyoyedeji@gmail.com",
    "url": "https://github.com/wemmyo"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wemmyo/joyvet-desktop/issues"
  },
  "keywords": [
    "electron",
    "react",
    "typescript",
    "vite",
    "electron-vite"
  ],
  "homepage": "https://github.com/wemmyo/joyvet-desktop#readme",
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@electron/rebuild": "^3.6.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^18.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "cross-env": "^7.0.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^28.1.0",
    "postcss": "^8.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-avatar": "^1.1.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.1.0",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dayjs": "^1.11.13",
    "electron-log": "^4.2.2",
    "electron-updater": "^6.3.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-hook-form": "^7.43.2",
    "react-router-dom": "^6.28.0",
    "react-to-print": "^3.0.0",
    "sequelize": "^6.37.8",
    "sonner": "^1.7.0",
    "sqlite3": "^5.1.6",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.20.6"
  },
  "devEngines": {
    "node": ">=18.x",
    "npm": ">=8.x",
    "yarn": ">=1.22.0"
  },
  "browserslist": []
}
